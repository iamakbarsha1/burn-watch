{
  "name": "@burn-watch/api",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('dist/package.json',JSON.stringify({type:'module'}))\"",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "dashboard-pipelines": "tsx src/scripts/dashboard-pipelines.ts"
  },
  "dependencies": {
    "@burn-watch/db": "*",
    "@burn-watch/shared": "*",
    "@fastify/jwt": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
