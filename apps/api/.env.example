MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/burnwatch
# Only read by `npm run copy-to-mongo`, the one-time Postgres copy.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/burnwatch?sslmode=require
JWT_SECRET=change-me-minimum-32-chars-long
JWT_REFRESH_SECRET=change-me-different-from-jwt-secret
PORT=3001
NODE_ENV=development
